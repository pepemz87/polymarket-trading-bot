# ============================================
# POLYMARKET API CREDENTIALS
# ============================================
# Get these from your Polymarket account
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here
POLYMARKET_PRIVATE_KEY=your_private_key_here

# ============================================
# CLAWBOT — WEATHER TRADING BOT CREDENTIALS
# ============================================
# Dedicated wallet for the weather bot (NEVER reuse your main wallet)
# Generate a new wallet:
#   python -c "from eth_account import Account; a=Account.create(); print(a.address, a.key.hex())"
POLY_PRIVATE_KEY=0x_your_new_wallet_private_key
POLY_WALLET_ADDRESS=0x_your_new_wallet_address

# CLOB API credentials — generate once with:
#   python weather_bot.py --setup-creds
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ============================================
# LLM API KEYS
# ============================================
# Google Gemini API (Free tier: 1500 requests/day)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (Free tier: 30 requests/minute)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Perplexity API (Paid)
# PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ============================================
# DATA SOURCE APIs (Optional)
# ============================================
# NewsAPI (Free tier: 100 requests/day)
# Get from: https://newsapi.org/
# NEWS_API_KEY=your_news_api_key_here

# The Odds API (Free tier: 500 requests/month)
# Get from: https://the-odds-api.com/
# ODDS_API_KEY=your_odds_api_key_here

# ============================================
# TRADING CONFIGURATION
# ============================================
# Set to 'paper' for simulation, 'live' for real trading
TRADING_MODE=paper

# Initial bankroll in USDC
INITIAL_BANKROLL=100

# ============================================
# NOTIFICATIONS (Optional)
# ============================================
# Telegram Bot Token (for alerts)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Email notifications
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
# EMAIL_TO=your_email@gmail.com

# ============================================
# ADVANCED SETTINGS
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database path
DATABASE_URL=sqlite:///data/trades.db
